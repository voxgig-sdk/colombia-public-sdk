# Entity: touristic_attraction

main: kit: entity: touristic_attraction: {

  alias: field: {}

  fields: [
    {
      name: "city"
      req: false
      short: "City where the attraction is located"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Attraction description"
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      short: "Touristic attraction ID"
      type: "`$INTEGER`"
    }
    {
      name: "images"
      req: false
      short: "List of image URLs"
      type: "`$ARRAY`"
    }
    {
      name: "latitude"
      req: false
      short: "Latitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "longitude"
      req: false
      short: "Longitude coordinate"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Attraction name"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "touristic_attraction"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/TouristicAttraction"
          segments: [
            {
              lit: "TouristicAttraction"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/TouristicAttraction/{id}"
          segments: [
            {
              lit: "TouristicAttraction"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
