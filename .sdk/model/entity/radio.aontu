# Entity: radio

main: kit: entity: radio: {

  alias: field: {}

  fields: {
    band: {
      h: "Band"
      n: "band"
      r: false
      sh: "Broadcasting band (AM/FM)"
      t: "`$STRING`"
    }
    frequency: {
      h: "Frequency"
      n: "frequency"
      r: false
      sh: "Broadcasting frequency"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "Radio station ID"
      t: "`$INTEGER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Radio station name"
      t: "`$STRING`"
    }
    url: {
      h: "Url"
      n: "url"
      r: false
      sh: "Station URL"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "radio"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /Radio"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/Radio"
          s: [
            {
              lit: "Radio"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /Radio/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$INTEGER`"
              }
            ]
          }
          m: "GET"
          o: "/Radio/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "Radio"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



